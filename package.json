{
  "name": "pradyumn",
  "version": "0.2.1",
  "description": "Ultra-declarative, zero-boilerplate TypeScript UI creation library for React.",
  "license": "MIT",
  "type": "module",
  "author": "technopradyumn <technopradyumn@gmail.com>",
  "keywords": [
    "react",
    "ui",
    "signals",
    "forms",
    "components",
    "hooks",
    "rules",
    "permissions",
    "feature-flags",
    "conditional-rendering",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technopradyumn/pradyumn.js.git"
  },
  "homepage": "https://github.com/technopradyumn/pradyumn.js#readme",
  "bugs": {
    "url": "https://github.com/technopradyumn/pradyumn.js/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.3",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  }
}
